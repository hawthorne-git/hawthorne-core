<%
  add_action = (action == 'add')
  edit_action = (action == 'update')

  select_country_form_url = add_action ? account_new_address_with_selected_country_path : nil
  url = add_action ? account_add_address_path : account_update_address_path

  title = "#{action.capitalize} address"

  token_value = @address.token

  country_label = 'Country'
  country_value = @selected_country.handle
  country_code_alpha2_value = @selected_country&.code_alpha2

  name_label = 'Name'
  name_value = @address.name

  street_address_label = 'Street address'
  street_address_value = @address.street_address

  street_address_extended_label = 'Apartment, unit, suite, or floor #'
  street_address_extended_value = @address.street_address_extended

  city_label = 'City'
  city_value = @address.city

  state_province_label = @selected_country&.us? ? 'State' : 'State / Province / Region'
  state_province_value = @address.state_province

  postal_code_label = @selected_country&.us? ? 'Zip code' : 'Postal code'
  postal_code_value = @address.postal_code

  phone_number_label = 'Phone number - required by select couriers'
  phone_number_value = @address.phone_number

  set_as_default_selectable = HawthorneCore::UserAddress.has_address?(user_id: session[:user_id]) if add_action
  set_as_default_selectable = !@address.default? && HawthorneCore::UserAddress.has_more_than_one_address?(user_id: session[:user_id]) if edit_action
  set_as_default_label = 'Set as default address'
  set_as_default_value = @address.default

  submit_button_text = "#{action.capitalize} Address"
%>

<%= render HawthorneCore::User::Layout::AddressesComponent.new(title:) do %>
  <%= render HawthorneCore::Form::FormWrapperComponent.new do %>

    <%= form_with url: select_country_form_url do |form| %>
      <% if add_action %>
        <%= render HawthorneCore::Form::Attr::Address::CountrySelectComponent.new(form:, countries: @ship_to_countries, selected_country: @selected_country) %>
      <% else %>
        <%= render HawthorneCore::Form::TextFieldComponent.new(form:, attribute: :country, label: country_label, value: country_value, disabled: true) %>
      <% end %>
    <% end %>

    <% if @selected_country %>
      <%= form_with model: @address, url: do |form| %>
        <%= render HawthorneCore::Form::HiddenFieldComponent.new(form:, attribute: :token, value: token_value, required: false) %>
        <%= render HawthorneCore::Form::HiddenFieldComponent.new(form:, attribute: :country_code_alpha2, value: country_code_alpha2_value, required: true) %>
        <%= render HawthorneCore::Form::HiddenFieldComponent.new(form:, attribute: :default, value: true, required: false) unless set_as_default_selectable %>
        <%= render HawthorneCore::Form::Attr::Address::AutocompleteAddressComponent.new(form:, model: @address, selected_country: @selected_country) if add_action %>
        <%= render HawthorneCore::Form::TextFieldComponent.new(form:, attribute: :name, label: name_label, value: name_value, required: true) %>
        <%= render HawthorneCore::Form::TextFieldComponent.new(form:, attribute: :street_address, label: street_address_label, value: street_address_value, required: true) %>
        <%= render HawthorneCore::Form::TextFieldComponent.new(form:, attribute: :street_address_extended, label: street_address_extended_label, value: street_address_extended_value) %>
        <%= render HawthorneCore::Form::TextFieldComponent.new(form:, attribute: :city, label: city_label, value: city_value, required: true) %>
        <%= render HawthorneCore::Form::Attr::Address::StateSelectComponent.new(form:, attribute: :state_province, label: state_province_label, value: state_province_value, selected_country: @selected_country, us_states: @us_states) %>
        <%= render HawthorneCore::Form::TextFieldComponent.new(form:, attribute: :postal_code, label: postal_code_label, value: postal_code_value, required: true) %>
        <%= render HawthorneCore::Form::TextFieldComponent.new(form:, attribute: :phone_number, label: phone_number_label, value: phone_number_value, required: true) %>
        <%= render HawthorneCore::Form::CheckBoxComponent.new(form:, attribute: :default, label: set_as_default_label, value: set_as_default_value) if set_as_default_selectable %>
        <%= render HawthorneCore::Form::SubmitButtonComponent.new(form:, submit_button_text:) %>
      <% end %>
    <% end %>

  <% end %>
<% end %>

<%= render partial: '/hawthorne_core/partials/autocomplete_address', locals: { model: @address, selected_country: @selected_country } if @selected_country %>