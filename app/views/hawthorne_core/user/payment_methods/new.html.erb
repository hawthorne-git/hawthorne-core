<%# v3.0 %>

<%
  title = 'Add credit card'
%>

<%= render HawthorneCore::UI::User::Layout::PaymentMethodsComponent.new(title:) do %>

  <div data-controller="stripe-card"
       data-stripe-card-publishable-key-value="<%= HawthorneCore::AppConfig.stripe_publishable_key %>"
       data-stripe-card-client-secret-value="<%= @service_key %>">

    <form data-action="submit->stripe-card#submit" class="cc-form">

      <div class="cc-row">
        <label class="cc-field-label">Card number</label>
        <div data-stripe-card-target="cardNumber" class="cc-field"></div>
      </div>

      <div class="cc-grid">
        <div>
          <label class="cc-field-label">Expiry</label>
          <div data-stripe-card-target="cardExpiry" class="cc-field"></div>
        </div>
        <div>
          <label class="cc-field-label">CVC</label>
          <div data-stripe-card-target="cardCvc" class="cc-field"></div>
        </div>
        <div>
          <label class="cc-field-label">ZIP</label>
          <input type="text" required
                 data-stripe-card-target="postalCode"
                 class="cc-field cc-field-input">
        </div>
      </div>

      <div data-stripe-card-target="errors" class="cc-errors"></div>

      <button type="submit" data-stripe-card-target="submit" class="cc-submit">
        Add Credit Card
      </button>

    </form>

  </div>

<% end %>
