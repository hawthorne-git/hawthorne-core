<div class="account-layout" data-controller="mobile-menu">
  <div class="mobile-menu-backdrop" data-action="click->mobile-menu#close"></div>
  <%= render HawthorneCore::User::SidebarComponent.new(selected_sidebar_navigation_item: @selected_sidebar_navigation_item) %>
  <div class="account-mobile-bar">
    <button type="button" class="mobile-menu-toggle" data-action="mobile-menu#toggle" aria-label="Toggle menu">
      <span class="mobile-menu-toggle__bar"></span>
      <span class="mobile-menu-toggle__bar"></span>
      <span class="mobile-menu-toggle__bar"></span>
    </button>
    <span class="account-mobile-bar__title"><%= @selected_sidebar_navigation_item %></span>
  </div>
  <main class="flex-1 px-12 py-10 max-w-2xl">
    <%= render HawthorneCore::User::BreadcrumbComponent.new(selected_sidebar_navigation_item: @selected_sidebar_navigation_item, title: @title) %>
    <%= render HawthorneCore::User::TitleComponent.new(text: @title) %>
    <%= content %>
  </main>
</div>