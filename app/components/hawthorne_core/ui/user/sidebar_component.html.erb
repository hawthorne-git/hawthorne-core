<%# v3.0 %>

<%

  # find the user - needed in the user greeting section
  user = HawthorneCore::User.find_by(user_id: session[:user_id])

  # navigation component titles
  addresses_handle = 'Addresses'
  favorites_handle = 'Favorites'
  gift_cards_handle = 'Gift Cards'
  notifications_handle = 'Notifications'
  orders_handle = 'Orders'
  payment_methods_handle = 'Credit Cards'
  profile_handle = 'Profile'

  # create each navigation component
  addresses_navigation_component = { handle: addresses_handle, url: helpers.account_addresses_path, selected: (@selected_sidebar_navigation_item == addresses_handle) }
  favorites_navigation_component = { handle: favorites_handle, url: helpers.account_favorites_path, selected: (@selected_sidebar_navigation_item == favorites_handle) }
  gift_cards_navigation_component = { handle: gift_cards_handle, url: helpers.account_gift_cards_path, selected: (@selected_sidebar_navigation_item == gift_cards_handle) }
  notifications_navigation_component = { handle: notifications_handle, url: helpers.account_notifications_path, selected: (@selected_sidebar_navigation_item == notifications_handle) }
  orders_navigation_component = { handle: orders_handle, url: helpers.account_orders_path, selected: (@selected_sidebar_navigation_item == orders_handle) }
  payment_methods_navigation_component = { handle: payment_methods_handle, url: helpers.account_payment_methods_path, selected: (@selected_sidebar_navigation_item == payment_methods_handle) }
  profile_navigation_component = { handle: profile_handle, url: helpers.account_profile_path, selected: (@selected_sidebar_navigation_item == profile_handle) }

  # set these navigation components into a list
  navigation_components =
    [
      profile_navigation_component,
      favorites_navigation_component,
      orders_navigation_component,
      notifications_navigation_component,
      addresses_navigation_component,
      payment_methods_navigation_component,
      gift_cards_navigation_component
    ]

%>

<%# Sidebar %>
<aside class="w-64 shrink-0 border-r border-gray-200 px-6 py-10">

  <%# Mobile-only close button — shown when sidebar is open %>
  <button type="button" class="sidebar-close" data-action="mobile-menu#close" aria-label="Close menu">&times;</button>

  <%# User greeting %>
  <div class="sidebar-greeting">

    <%# Avatar: first letter of name, or a generic person icon %>
    <div class="sidebar-avatar">
      <% if user.first_name? %>
        <span class="sidebar-avatar__initial"><%= user.first_name.upcase.first %></span>
      <% else %>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="sidebar-avatar__icon">
          <path fill-rule="evenodd" d="M7.5 6a4.5 4.5 0 1 1 9 0 4.5 4.5 0 0 1-9 0ZM3.751 20.105a8.25 8.25 0 0 1 16.498 0 .75.75 0 0 1-.437.695A18.683 18.683 0 0 1 12 22.5c-2.786 0-5.433-.608-7.812-1.7a.75.75 0 0 1-.437-.695Z" clip-rule="evenodd" />
        </svg>
      <% end %>
    </div>

    <%# Name and email %>
    <div>
      <p class="sidebar-greeting__name">Hello<%= user.first_name? ? ", #{user.first_name.capitalize}" : '' %></p>
      <p class="sidebar-greeting__email" data-turbo-permanent id="sidebar-greeting-email"><%= user.email %></p>
    </div>

  </div>

  <%# Navigation %>
  <nav class="flex flex-col gap-1 text-sm">
    <% navigation_components.each do |navigation_component| %>
      <%= render HawthorneCore::UI::User::SidebarNavigationComponent.new(navigation_component: navigation_component) %>
    <% end %>
  </nav>

  <%# Sign out %>
  <div class="mt-10 pt-6 border-t border-gray-200">
    <%= link_to 'Logout', helpers.sign_out_path, data: { turbo: :false }, class: "px-3 py-2 text-sm text-gray-500 hover:text-gray-700 no-underline hover:no-underline block" %>
  </div>

</aside>