<% if @search %>
  <%# a new search starts over, keeping only the sort %>
  <%= form_with url: @url, method: :get, class: 'product-search', html: { role: 'search' }, data: { turbo: false } do %>
    <% unless @filter.default_sort? %>
      <input type='hidden' name='sort' value='<%= @filter.sort %>'>
    <% end %>
    <svg class='product-search__icon' xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 20 20' fill='none' stroke='currentColor' stroke-width='1.5' stroke-linecap='round' aria-hidden='true'>
      <circle cx='9' cy='9' r='5.5' />
      <path d='M13 13l4 4' />
    </svg>
    <input type='search' name='q' value='<%= @filter.search %>' class='product-search__input' aria-label='Search' placeholder='Describe what you’re looking for, like an easy quilt kit under $100' autocomplete='off' maxlength='<%= ProductSearch::MAX_LENGTH %>'>
    <%# voice search: shown only in browsers that can turn speech into text (see the script below) %>
    <button type='button' class='product-search__voice' aria-label='Search by voice' aria-pressed='false' title='Search by voice' data-search-voice hidden>
      <svg xmlns='http://www.w3.org/2000/svg' width='20' height='20' viewBox='0 0 20 20' fill='none' stroke='currentColor' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'>
        <rect x='7' y='2.5' width='6' height='10' rx='3' />
        <path d='M4.5 9.5a5.5 5.5 0 0 0 11 0M10 15v2.5' />
      </svg>
    </button>
    <button type='submit' class='product-search__button'>Search</button>
  <% end %>
  <% if @filter.searched? %>
    <p class='product-search__summary'>
      <% if @filter.search.present? %>
        Results for “<%= @filter.search %>”
      <% end %>
      <% search_details.each do |detail| %>
        <span class='product-search__detail'><%= detail %></span>
      <% end %>
      <%= link_to 'Clear search', @url, class: 'product-filters__clear' %>
    </p>
  <% end %>
<% end %>

<%= form_with url: @url, method: :get, class: 'product-filters', html: { novalidate: true }, data: { turbo: false } do %>
  <%# applying a filter keeps the current sort and search. no browser validation, so a price off the price boxes' step (ex: 95 when it's 10) can still be applied %>
  <% unless @filter.default_sort? %>
    <input type='hidden' name='sort' value='<%= @filter.sort %>'>
  <% end %>
  <%= search_fields %>
  <div class='product-filters__left'>
    <button type='button' class='product-filters__chip' commandfor='filter-drawer' command='show-modal'>
      <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 20 20' fill='none' stroke='currentColor' stroke-width='1.5' stroke-linecap='round' aria-hidden='true'>
        <path d='M3 6h9M15 6h2M3 14h2M8 14h9' />
        <circle cx='13.5' cy='6' r='1.5' />
        <circle cx='6.5' cy='14' r='1.5' />
      </svg>
      Filter
    </button>

    <% if @filter.type_filter? %>
      <details class='product-filters__dropdown'>
        <summary class='product-filters__chip<%= ' product-filters__chip--active' if @filter.selected_types.any? %>'>
          <%= label('Type', @filter.selected_types) %>
          <svg class='product-filters__chevron' xmlns='http://www.w3.org/2000/svg' viewBox='0 0 20 20' fill='none' stroke='currentColor' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'>
            <path d='M5 8l5 5 5-5' />
          </svg>
        </summary>
        <div class='product-filters__panel'>
          <% @filter.type_options.each do |type, text, count| %>
            <label class='product-filters__option'>
              <input type='checkbox' name='type[]' value='<%= type %>' data-filter-single<%= ' checked' if @filter.selected_types.include?(type) %>>
              <span><%= text %></span>
              <span class='product-filters__count'><%= count %></span>
            </label>
          <% end %>
          <button type='submit' class='product-filters__apply'>Apply</button>
        </div>
      </details>
    <% end %>

    <% if @filter.quilt_size_filter? %>
      <details class='product-filters__dropdown'>
        <summary class='product-filters__chip<%= ' product-filters__chip--active' if @filter.selected_quilt_sizes.any? || @filter.custom_quilt_size? %>'>
          <%= quilt_size_label %>
          <svg class='product-filters__chevron' xmlns='http://www.w3.org/2000/svg' viewBox='0 0 20 20' fill='none' stroke='currentColor' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'>
            <path d='M5 8l5 5 5-5' />
          </svg>
        </summary>
        <%# wider, so the width / length boxes have room beside their labels %>
        <div class='product-filters__panel product-filters__panel--wide'>
          <% @filter.quilt_size_options.each do |key, text, count| %>
            <label class='product-filters__option'>
              <input type='checkbox' name='size[]' value='<%= key %>'<%= ' checked' if @filter.selected_quilt_sizes.include?(key) %>>
              <span><%= text %></span>
              <span class='product-filters__count'><%= count %></span>
            </label>
          <% end %>
          <div class='product-filters__custom-price'>
            <span class='product-filters__custom-price-or'>or</span>
            <% quilt_size_sides.each do |side, text, min, max| %>
              <div class='product-filters__custom-price-boxes product-filters__custom-size-boxes'>
                <span class='product-filters__custom-size-side'><%= text %></span>
                <label class='product-filters__price-box'>
                  <input type='number' name='min_<%= side %>' value='<%= number_box_value(min) %>' min='0' step='any' inputmode='decimal' placeholder='Min' aria-label='Minimum <%= side %>, in inches' data-filter-custom-size>
                  <span>″</span>
                </label>
                <span>to</span>
                <label class='product-filters__price-box'>
                  <input type='number' name='max_<%= side %>' value='<%= number_box_value(max) %>' min='0' step='any' inputmode='decimal' placeholder='Max' aria-label='Maximum <%= side %>, in inches' data-filter-custom-size>
                  <span>″</span>
                </label>
              </div>
            <% end %>
          </div>
          <button type='submit' class='product-filters__apply'>Apply</button>
        </div>
      </details>
    <% end %>

    <% if @filter.difficulty_filter? %>
      <details class='product-filters__dropdown'>
        <summary class='product-filters__chip<%= ' product-filters__chip--active' if @filter.selected_difficulties.any? %>'>
          <%= label('Difficulty', @filter.selected_difficulties) %>
          <svg class='product-filters__chevron' xmlns='http://www.w3.org/2000/svg' viewBox='0 0 20 20' fill='none' stroke='currentColor' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'>
            <path d='M5 8l5 5 5-5' />
          </svg>
        </summary>
        <div class='product-filters__panel'>
          <% @filter.difficulty_options.each do |difficulty, text, count| %>
            <label class='product-filters__option'>
              <input type='checkbox' name='difficulty[]' value='<%= difficulty %>'<%= ' checked' if @filter.selected_difficulties.include?(difficulty) %>>
              <span><%= text %></span>
              <span class='product-filters__count'><%= count %></span>
            </label>
          <% end %>
          <button type='submit' class='product-filters__apply'>Apply</button>
        </div>
      </details>
    <% end %>

    <details class='product-filters__dropdown'>
      <summary class='product-filters__chip<%= ' product-filters__chip--active' if @filter.selected_supplier_tokens.any? %>'>
        <%= label('Supplier', @filter.selected_supplier_tokens) %>
        <svg class='product-filters__chevron' xmlns='http://www.w3.org/2000/svg' viewBox='0 0 20 20' fill='none' stroke='currentColor' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'>
          <path d='M5 8l5 5 5-5' />
        </svg>
      </summary>
      <div class='product-filters__panel'>
        <% @filter.supplier_options.each do |supplier, count| %>
          <label class='product-filters__option'>
            <input type='checkbox' name='supplier[]' value='<%= supplier.token %>'<%= ' checked' if @filter.selected_supplier_tokens.include?(supplier.token) %>>
            <span><%= supplier.handle %></span>
            <span class='product-filters__count'><%= count %></span>
          </label>
        <% end %>
        <button type='submit' class='product-filters__apply'>Apply</button>
      </div>
    </details>

    <details class='product-filters__dropdown'>
      <summary class='product-filters__chip<%= ' product-filters__chip--active' if @filter.selected_price_ranges.any? || @filter.custom_price? || @filter.on_sale? %>'>
        <%= price_range_label %>
        <svg class='product-filters__chevron' xmlns='http://www.w3.org/2000/svg' viewBox='0 0 20 20' fill='none' stroke='currentColor' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'>
          <path d='M5 8l5 5 5-5' />
        </svg>
      </summary>
      <div class='product-filters__panel'>
        <%# on sale goes with the price ranges or custom price %>
        <label class='product-filters__option product-filters__option--sale'>
          <input type='checkbox' name='sale' value='1'<%= ' checked' if @filter.on_sale? %>>
          <span>On Sale</span>
          <span class='product-filters__count'><%= @filter.sale_count %></span>
        </label>
        <% @filter.price_range_options.each do |key, text, count| %>
          <label class='product-filters__option'>
            <input type='checkbox' name='price[]' value='<%= key %>'<%= ' checked' if @filter.selected_price_ranges.include?(key) %>>
            <span><%= text %></span>
            <span class='product-filters__count'><%= count %></span>
          </label>
        <% end %>
        <div class='product-filters__custom-price'>
          <span class='product-filters__custom-price-or'>or</span>
          <div class='product-filters__custom-price-boxes'>
            <label class='product-filters__price-box'>
              <span>$</span>
              <input type='number' name='min_price' value='<%= number_box_value(@filter.min_price) %>' min='0' step='<%= @price_step || 'any' %>' inputmode='decimal' placeholder='Min' aria-label='Minimum price' data-filter-custom-price>
            </label>
            <span>to</span>
            <label class='product-filters__price-box'>
              <span>$</span>
              <input type='number' name='max_price' value='<%= number_box_value(@filter.max_price) %>' min='0' step='<%= @price_step || 'any' %>' inputmode='decimal' placeholder='Max' aria-label='Maximum price' data-filter-custom-price>
            </label>
          </div>
        </div>
        <button type='submit' class='product-filters__apply'>Apply</button>
      </div>
    </details>

    <details class='product-filters__dropdown'>
      <summary class='product-filters__chip<%= ' product-filters__chip--active' if @filter.selected_stock.any? %>'>
        <%= label('Stock', @filter.selected_stock) %>
        <svg class='product-filters__chevron' xmlns='http://www.w3.org/2000/svg' viewBox='0 0 20 20' fill='none' stroke='currentColor' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'>
          <path d='M5 8l5 5 5-5' />
        </svg>
      </summary>
      <div class='product-filters__panel'>
        <% @filter.stock_options.each do |key, text, count| %>
          <label class='product-filters__option'>
            <input type='checkbox' name='stock[]' value='<%= key %>' data-filter-single<%= ' checked' if @filter.selected_stock.include?(key) %>>
            <span><%= text %></span>
            <span class='product-filters__count'><%= count %></span>
          </label>
        <% end %>
        <button type='submit' class='product-filters__apply'>Apply</button>
      </div>
    </details>

    <% if @filter.any_selected? %>
      <%= link_to 'Clear all', listing_path(type: [], size: [], min_width: nil, max_width: nil, min_length: nil, max_length: nil, difficulty: [], supplier: [], price: [], min_price: nil, max_price: nil, sale: nil, stock: []), class: 'product-filters__clear' %>
    <% end %>
  </div>

  <div class='product-filters__right'>
    <span class='product-filters__total'><%= pluralize(@filter.products.size, 'item') %></span>
    <details class='product-filters__dropdown'>
      <summary class='product-filters__chip<%= ' product-filters__chip--active' unless @filter.default_sort? %>'>
        Sort By
        <svg class='product-filters__chevron' xmlns='http://www.w3.org/2000/svg' viewBox='0 0 20 20' fill='none' stroke='currentColor' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'>
          <path d='M5 8l5 5 5-5' />
        </svg>
      </summary>
      <div class='product-filters__panel product-filters__panel--right'>
        <% ProductFilter::SORTS.each do |key, text| %>
          <% selected = key == @filter.sort %>
          <%= link_to listing_path(sort: key), class: "product-filters__sort#{' product-filters__sort--selected' if selected}", 'aria-current': (true if selected) do %>
            <span><%= text %></span>
            <% if selected %>
              <svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 20 20' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'>
                <path d='M4 10l4 4 8-8' />
              </svg>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </details>
  </div>
<% end %>

<%# the filter drawer: every filter in one window on the left, opened by the filter button; nothing applies until view %>
<dialog id='filter-drawer' class='filter-drawer' aria-label='Filter'>
  <%= form_with url: @url, method: :get, class: 'filter-drawer__form', html: { novalidate: true }, data: { turbo: false, facets: @filter.facets.to_json } do %>
    <% unless @filter.default_sort? %>
      <input type='hidden' name='sort' value='<%= @filter.sort %>'>
    <% end %>
    <%= search_fields %>
    <div class='filter-drawer__header'>
      <h2 class='filter-drawer__title'>Filter</h2>
      <button type='button' class='filter-drawer__close' commandfor='filter-drawer' command='close' aria-label='Close'>&times;</button>
    </div>

    <div class='filter-drawer__body'>
      <% if @filter.type_filter? %>
        <details class='filter-drawer__section' open>
          <summary>
            Type
            <svg class='product-filters__chevron' xmlns='http://www.w3.org/2000/svg' viewBox='0 0 20 20' fill='none' stroke='currentColor' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'>
              <path d='M5 8l5 5 5-5' />
            </svg>
          </summary>
          <% @filter.types.each do |type| %>
            <label class='product-filters__option'>
              <input type='checkbox' name='type[]' value='<%= type %>' data-filter-single<%= ' checked' if @filter.selected_types.include?(type) %>>
              <span><%= @filter.type_label(type) %></span>
            </label>
          <% end %>
        </details>
      <% end %>

      <%# shown while quilt is checked above %>
      <% if @filter.quilt_sizes? %>
        <details class='filter-drawer__section' open data-filter-when-type='<%= ProductFilter::QUILT_TYPE %>'<%= ' hidden' unless @filter.quilt_size_filter? %>>
          <summary>
            Size
            <svg class='product-filters__chevron' xmlns='http://www.w3.org/2000/svg' viewBox='0 0 20 20' fill='none' stroke='currentColor' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'>
              <path d='M5 8l5 5 5-5' />
            </svg>
          </summary>
          <% ProductFilter::QUILT_SIZES.each do |key, (text, _, _)| %>
            <label class='product-filters__option'>
              <input type='checkbox' name='size[]' value='<%= key %>'<%= ' checked' if @filter.selected_quilt_sizes.include?(key) %>>
              <span><%= text %></span>
            </label>
          <% end %>
          <div class='product-filters__custom-price'>
            <span class='product-filters__custom-price-or'>or</span>
            <% quilt_size_sides.each do |side, text, min, max| %>
              <div class='product-filters__custom-price-boxes product-filters__custom-size-boxes'>
                <span class='product-filters__custom-size-side'><%= text %></span>
                <label class='product-filters__price-box'>
                  <input type='number' name='min_<%= side %>' value='<%= number_box_value(min) %>' min='0' step='any' inputmode='decimal' placeholder='Min' aria-label='Minimum <%= side %>, in inches' data-filter-custom-size>
                  <span>″</span>
                </label>
                <span>to</span>
                <label class='product-filters__price-box'>
                  <input type='number' name='max_<%= side %>' value='<%= number_box_value(max) %>' min='0' step='any' inputmode='decimal' placeholder='Max' aria-label='Maximum <%= side %>, in inches' data-filter-custom-size>
                  <span>″</span>
                </label>
              </div>
            <% end %>
          </div>
        </details>
      <% end %>

      <% if @filter.difficulty_filter? %>
        <details class='filter-drawer__section' open>
          <summary>
            Difficulty
            <svg class='product-filters__chevron' xmlns='http://www.w3.org/2000/svg' viewBox='0 0 20 20' fill='none' stroke='currentColor' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'>
              <path d='M5 8l5 5 5-5' />
            </svg>
          </summary>
          <% @filter.difficulties.each do |difficulty| %>
            <label class='product-filters__option'>
              <input type='checkbox' name='difficulty[]' value='<%= difficulty %>'<%= ' checked' if @filter.selected_difficulties.include?(difficulty) %>>
              <span><%= @filter.difficulty_label(difficulty) %></span>
            </label>
          <% end %>
        </details>
      <% end %>

      <details class='filter-drawer__section' open>
        <summary>
          Supplier
          <svg class='product-filters__chevron' xmlns='http://www.w3.org/2000/svg' viewBox='0 0 20 20' fill='none' stroke='currentColor' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'>
            <path d='M5 8l5 5 5-5' />
          </svg>
        </summary>
        <% @filter.suppliers.each do |supplier| %>
          <label class='product-filters__option'>
            <input type='checkbox' name='supplier[]' value='<%= supplier.token %>'<%= ' checked' if @filter.selected_supplier_tokens.include?(supplier.token) %>>
            <span><%= supplier.handle %></span>
          </label>
        <% end %>
      </details>

      <details class='filter-drawer__section' open>
        <summary>
          Price Range
          <svg class='product-filters__chevron' xmlns='http://www.w3.org/2000/svg' viewBox='0 0 20 20' fill='none' stroke='currentColor' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'>
            <path d='M5 8l5 5 5-5' />
          </svg>
        </summary>
        <label class='product-filters__option product-filters__option--sale'>
          <input type='checkbox' name='sale' value='1'<%= ' checked' if @filter.on_sale? %>>
          <span>On Sale</span>
        </label>
        <% ProductFilter::PRICE_RANGES.each do |key, (text, _, _)| %>
          <label class='product-filters__option'>
            <input type='checkbox' name='price[]' value='<%= key %>'<%= ' checked' if @filter.selected_price_ranges.include?(key) %>>
            <span><%= text %></span>
          </label>
        <% end %>
        <div class='product-filters__custom-price'>
          <span class='product-filters__custom-price-or'>or</span>
          <div class='product-filters__custom-price-boxes'>
            <label class='product-filters__price-box'>
              <span>$</span>
              <input type='number' name='min_price' value='<%= number_box_value(@filter.min_price) %>' min='0' step='<%= @price_step || 'any' %>' inputmode='decimal' placeholder='Min' aria-label='Minimum price' data-filter-custom-price>
            </label>
            <span>to</span>
            <label class='product-filters__price-box'>
              <span>$</span>
              <input type='number' name='max_price' value='<%= number_box_value(@filter.max_price) %>' min='0' step='<%= @price_step || 'any' %>' inputmode='decimal' placeholder='Max' aria-label='Maximum price' data-filter-custom-price>
            </label>
          </div>
        </div>
      </details>

      <details class='filter-drawer__section' open>
        <summary>
          Stock
          <svg class='product-filters__chevron' xmlns='http://www.w3.org/2000/svg' viewBox='0 0 20 20' fill='none' stroke='currentColor' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round' aria-hidden='true'>
            <path d='M5 8l5 5 5-5' />
          </svg>
        </summary>
        <% ProductFilter::STOCK_STATUSES.each do |key, text| %>
          <label class='product-filters__option'>
            <input type='checkbox' name='stock[]' value='<%= key %>' data-filter-single<%= ' checked' if @filter.selected_stock.include?(key) %>>
            <span><%= text %></span>
          </label>
        <% end %>
      </details>
    </div>

    <div class='filter-drawer__footer'>
      <button type='button' class='filter-drawer__clear' data-filter-clear>Clear</button>
      <button type='submit' class='filter-drawer__view'>View (<span data-filter-total><%= @filter.products.size %></span>)</button>
    </div>
  <% end %>
</dialog>

<script>
  // registered once per page:
  // - one filter dropdown open at a time, and a click outside closes it
  // - a single-choice filter (data-filter-single, ex: type, stock) unchecks its other boxes when one is checked
  // - the filter drawer closes on a backdrop click, opens / closes for browsers without invoker commands, and its
  //   view button counts the products matching the checked boxes (from the form's data-facets), as they change
  // - a drawer section for one type (data-filter-when-type, ex: quilt size) shows only while that type is checked, and
  //   is cleared when it hides
  // - the price filter is price ranges or a custom min / max price (data-filter-custom-price), not both: checking a
  //   range clears the custom price, and typing a custom price unchecks the ranges. likewise the quilt size filter is
  //   quilt sizes or a custom min / max width and length (data-filter-custom-size). empty boxes aren't submitted
  // - voice search (data-search-voice), in browsers that turn speech into text (Chrome, Edge, Safari; not Firefox):
  //   tapping the mic listens, writing what's heard into the search box as it's said, then searches (with voice=1, so
  //   the search is saved as spoken) once the shopper pauses for a second; tapping it again stops listening
  // - a search submits once: its buttons are disabled (the search button reads "Searching…") until the results load,
  //   since Claude takes a second or two to answer and shoppers click again (often search, after a voice search)
  if (window.SpeechRecognition || window.webkitSpeechRecognition) {
    document.querySelectorAll('[data-search-voice]').forEach((button) => { button.hidden = false; });
  }

  if (!window.productFiltersReady) {
    window.productFiltersReady = true;

    // how long a voice search waits, in milliseconds: for the shopper to finish once they pause, and to start talking
    const VOICE_PAUSE = 1000;
    const VOICE_START = 8000;

    let recognition = null;

    document.addEventListener('click', (event) => {
      const button = event.target.closest('[data-search-voice]');
      if (!button) return;
      if (recognition) {
        recognition.stop();
        return;
      }

      const form = button.closest('form');
      const input = form.querySelector('input[name="q"]');
      const typed = input.value;
      const placeholder = input.placeholder;
      let heard = '';
      let blocked = false;
      let silence = null;

      // stops listening after the given milliseconds without hearing anything new
      const stopAfter = (wait) => {
        clearTimeout(silence);
        silence = setTimeout(() => recognition?.stop(), wait);
      };

      recognition = new (window.SpeechRecognition || window.webkitSpeechRecognition)();
      recognition.lang = document.documentElement.lang || 'en-US';
      recognition.interimResults = true;
      // the browser's own end of speech comes at the first short pause, so it listens continuously and stops itself
      // once the shopper pauses for VOICE_PAUSE (or says nothing for VOICE_START)
      recognition.continuous = true;
      recognition.onresult = (result) => {
        heard = [...result.results].map((alternatives) => alternatives[0].transcript).join(' ').replace(/\s+/g, ' ').trim();
        input.value = heard;
        stopAfter(VOICE_PAUSE);
      };
      recognition.onerror = (error) => {
        blocked = error.error === 'not-allowed' || error.error === 'service-not-allowed';
      };
      recognition.onend = () => {
        clearTimeout(silence);
        recognition = null;
        form.classList.remove('product-search--listening');
        button.setAttribute('aria-pressed', 'false');
        input.placeholder = blocked ? 'Allow the microphone in your browser to search by voice' : placeholder;
        if (heard) {
          const voice = document.createElement('input');
          voice.type = 'hidden';
          voice.name = 'voice';
          voice.value = '1';
          voice.dataset.searchVoiceFlag = '';
          form.append(voice);
          form.requestSubmit();
        } else {
          input.value = typed;
        }
      };

      form.classList.add('product-search--listening');
      button.setAttribute('aria-pressed', 'true');
      input.value = '';
      input.placeholder = 'Listening…';
      recognition.start();
      stopAfter(VOICE_START);
    });

    const updateTotal = (form) => {
      const checked = (name) => [...form.querySelectorAll(`input[name="${name}[]"]:checked`)].map((input) => input.value);
      const types = checked('type');
      form.querySelectorAll('[data-filter-when-type]').forEach((section) => {
        section.hidden = !types.includes(section.dataset.filterWhenType);
        if (section.hidden) {
          section.querySelectorAll('input[type="checkbox"]').forEach((input) => { input.checked = false; });
          section.querySelectorAll('[data-filter-custom-size]').forEach((input) => { input.value = ''; });
        }
      });
      const suppliers = checked('supplier');
      const prices = checked('price');
      const sizes = checked('size');
      const difficulties = checked('difficulty');
      const stock = checked('stock');
      const sale = form.querySelector('input[name="sale"]')?.checked;
      // a custom min / max pair's limits (NaN when blank), swapped when the min is over the max
      const customRange = (name) => {
        const limit = (bound) => parseFloat(form.querySelector(`input[name="${bound}_${name}"]`)?.value);
        const [min, max] = [limit('min'), limit('max')];
        return min > max ? [max, min] : [min, max];
      };
      const custom = ([min, max]) => !isNaN(min) || !isNaN(max);
      const within = (value, [min, max]) => {
        if (!custom([min, max])) return true;
        return value !== null && (isNaN(min) || value >= min) && (isNaN(max) || value <= max);
      };
      const priceRange = customRange('price');
      const widthRange = customRange('width');
      const lengthRange = customRange('length');
      const priceMatch = (key, amount) => {
        if (!custom(priceRange)) return prices.length === 0 || prices.includes(key);
        return within(amount, priceRange);
      };
      const sizeMatch = (key, width, length) => {
        if (!custom(widthRange) && !custom(lengthRange)) return sizes.length === 0 || sizes.includes(key);
        return within(width, widthRange) && within(length, lengthRange);
      };
      const total = JSON.parse(form.dataset.facets).filter(([supplier, price, type, size, difficulty, amount, stocked, width, length, onSale]) => {
        return (suppliers.length === 0 || suppliers.includes(supplier)) && priceMatch(price, amount) &&
          (types.length === 0 || types.includes(type)) && sizeMatch(size, width, length) &&
          (difficulties.length === 0 || difficulties.includes(difficulty)) && (stock.length === 0 || stock.includes(stocked)) &&
          (!sale || onSale);
      }).length;
      form.querySelector('[data-filter-total]').textContent = total;
    };

    document.addEventListener('click', (event) => {
      document.querySelectorAll('.product-filters__dropdown[open]').forEach((dropdown) => {
        if (!dropdown.contains(event.target)) dropdown.open = false;
      });
      if (event.target.matches('dialog.filter-drawer')) {
        event.target.close();
        return;
      }
      const clear = event.target.closest('[data-filter-clear]');
      if (clear) {
        const form = clear.closest('form');
        form.querySelectorAll('input[type="checkbox"]').forEach((input) => { input.checked = false; });
        form.querySelectorAll('[data-filter-custom-price], [data-filter-custom-size]').forEach((input) => { input.value = ''; });
        updateTotal(form);
        return;
      }
      const invoker = event.target.closest('button[commandfor="filter-drawer"]');
      if (invoker && !('command' in HTMLButtonElement.prototype)) {
        const drawer = document.getElementById('filter-drawer');
        invoker.getAttribute('command') === 'show-modal' ? drawer.showModal() : drawer.close();
      }
    });

    document.addEventListener('change', (event) => {
      if (event.target.matches('input[data-filter-single]') && event.target.checked) {
        event.target.form.querySelectorAll(`input[name="${event.target.name}"]`).forEach((input) => {
          if (input !== event.target) input.checked = false;
        });
      }
      if (event.target.matches('input[name="price[]"]') && event.target.checked) {
        event.target.form.querySelectorAll('[data-filter-custom-price]').forEach((input) => { input.value = ''; });
      }
      if (event.target.matches('input[name="size[]"]') && event.target.checked) {
        event.target.form.querySelectorAll('[data-filter-custom-size]').forEach((input) => { input.value = ''; });
      }
      const form = event.target.closest('.filter-drawer__form');
      if (form) updateTotal(form);
    });

    document.addEventListener('input', (event) => {
      const ranges = event.target.matches('[data-filter-custom-price]') ? 'price' : event.target.matches('[data-filter-custom-size]') ? 'size' : null;
      if (!ranges) return;
      if (event.target.value !== '') {
        event.target.form.querySelectorAll(`input[name="${ranges}[]"]`).forEach((input) => { input.checked = false; });
      }
      const form = event.target.closest('.filter-drawer__form');
      if (form) updateTotal(form);
    });

    document.addEventListener('submit', (event) => {
      event.target.querySelectorAll('[data-filter-custom-price], [data-filter-custom-size]').forEach((input) => { input.disabled = input.value === ''; });
      if (!event.target.matches('.product-search')) return;
      if (event.target.dataset.searching) {
        event.preventDefault();
        return;
      }
      event.target.dataset.searching = 'true';
      event.target.querySelectorAll('button').forEach((button) => { button.disabled = true; });
      event.target.querySelector('.product-search__button').textContent = 'Searching…';
    });

    // a page restored by the back button keeps the boxes and search buttons disabled on submit, so they're turned back
    // on, and a voice search's flag, so a typed search from it isn't saved as spoken
    window.addEventListener('pageshow', () => {
      document.querySelectorAll('[data-filter-custom-price], [data-filter-custom-size]').forEach((input) => { input.disabled = false; });
      document.querySelectorAll('[data-search-voice-flag]').forEach((input) => { input.remove(); });
      document.querySelectorAll('.product-search[data-searching]').forEach((form) => {
        delete form.dataset.searching;
        form.querySelectorAll('button').forEach((button) => { button.disabled = false; });
        form.querySelector('.product-search__button').textContent = 'Search';
      });
    });
  }
</script>
